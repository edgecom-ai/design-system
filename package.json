{
  "name": "edgecom-design-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint",
    "typecheck": "pnpm run docs:changelog && tsc --noEmit",
    "verify:docs": "node scripts/verify-docs.mjs",
    "docs:source": "node scripts/gen-docs-source.mjs",
    "docs:tokens": "node scripts/gen-tokens.mjs",
    "docs:api": "node scripts/gen-api.mjs",
    "docs:contracts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-contracts.mjs",
    "docs:agents": "node scripts/gen-agents-md.mjs",
    "docs:routes": "node scripts/gen-routes.mjs",
    "docs:design-md": "node scripts/gen-design-md.mjs",
    "docs:llms": "node scripts/gen-llms.mjs",
    "docs:changelog": "node scripts/gen-changelog.mjs",
    "docs:gen": "node scripts/gen-changelog.mjs && node scripts/gen-tokens.mjs && node scripts/gen-docs-source.mjs && node scripts/gen-api.mjs && pnpm run docs:contracts && node scripts/gen-agents-md.mjs && node scripts/gen-routes.mjs && node scripts/gen-design-md.mjs && node scripts/gen-llms.mjs",
    "registry:gen": "node scripts/gen-registry.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:sections": "node scripts/check-sections.mjs",
    "registry:build": "pnpm run registry:gen && shadcn build && pnpm run registry:check",
    "design:sync": "node scripts/gen-design-sync.mjs",
    "predev": "pnpm run docs:gen",
    "prebuild": "pnpm run docs:gen && pnpm run registry:build",
    "design:css": "node scripts/gen-design-css.mjs",
    "design:entry": "node scripts/gen-design-entry.mjs",
    "design:build": "pnpm run design:css && DESIGN_SYNC_ALLOW_DIRTY=1 pnpm run design:sync && pnpm run design:entry",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@stepperize/react": "^7.0.0",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^8.21.3",
    "chrono-node": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "little-date": "^1.2.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "papaparse": "^5.5.4",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-aria-components": "^1.19.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-payment-inputs": "^1.2.0",
    "react-phone-number-input": "^3.4.17",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/node": "^4.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-payment-inputs": "^1.1.4",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "shiki": "^4.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "types": "dist/index.d.ts"
}
