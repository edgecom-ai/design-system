# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated docs source (run `npm run docs:source`)
/public/docs-source/

# generated changelog (run `pnpm docs:changelog`)
# Untracked on purpose: these embed commit SHAs, and the repo rebase-merges, so
# any committed copy links to commits that no longer exist. Regenerated by
# predev/prebuild; the deploy needs `fetch-depth: 0` to build them correctly.
/CHANGELOG.md
/public/changelog.md
/src/docs/generated/changelog.ts

# design-sync bundle (run `pnpm design:sync`)
# Generated output uploaded to the Claude Design project; embeds the compiled
# stylesheet, so it is rebuilt rather than committed.
/.design-sync/bundle/
