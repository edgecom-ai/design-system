# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# docs site build output (Vite)
/out/
/.vite/
# Left over from the Next.js era. Kept so a tree that still has one from before
# the Vite migration can't have it swept into a commit by `git add -A`.
/.next/

# Freshness stamps for the docs generators (scripts/lib/stale.mjs). A cache and
# nothing else: deleting it only costs time, it never changes an output.
/.cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# generated docs source (run `npm run docs:source`)
/public/docs-source/

# generated changelog (run `pnpm docs:changelog`)
# Untracked on purpose: these embed commit SHAs, and the repo rebase-merges, so
# any committed copy links to commits that no longer exist. Regenerated by
# predev/prebuild; the deploy needs `fetch-depth: 0` to build them correctly.
/CHANGELOG.md
/public/changelog.md
/src/docs/generated/changelog.ts

# design-sync bundle (run `pnpm design:sync`)
# Generated output uploaded to the Claude Design project; embeds the compiled
# stylesheet, so it is rebuilt rather than committed.
/.design-sync/bundle/

# design-sync (official converter) machine state — see .design-sync/README.md
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules
# Internal to a maintainer's machine, and this repo is public: config.json holds
# a Claude Design project id, NOTES.md holds project ids, internal timelines and
# programme notes. The committable parts are README.md, conventions.md and
# previews/.
/.design-sync/config.json
/.design-sync/NOTES.md

# design-system package entry for the Claude Design converter (`pnpm design:entry`)
/dist/

# Internal programme notes — project ids, timelines, metrics. This repo is
# public; these exist only on a maintainer's machine.
/docs/
